{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@sam-ort": [
        "node_modules/@huggingface/transformers/node_modules/onnxruntime-common/dist/esm/index.d.ts"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/**/*.d.ts",
    "src/core/**/*",
    "src/application/**/*"
  ]
}
